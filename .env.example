# Where the online booking app runs (page, scripts, stylesheet and /api backend). This site proxies /booking, /api
# and /assets to it, so booking works on this site's own URLs. See README, "Booking".
# Default: the original site, which works while nailsalonphoenix.com still points at it.
# When this site takes over nailsalonphoenix.com, set this to a hostname that still reaches the original app.
BOOKING_ORIGIN=https://nailsalonphoenix.com

# The public address the booking app believes it is served from. It checks the Origin/Referer of booking requests
# against it, and the proxy rewrites those headers to this value. Normally leave as is.
BOOKING_PUBLIC_ORIGIN=https://nailsalonphoenix.com
